          "id": "9fac1c9b-390c-4a64-9838-349b766c7a89",
          "name": "Get transaction request for withdrawing collected integrator's fees by chain",
          "request": {
            "name": "Get transaction request for withdrawing collected integrator's fees by chain",
            "description": {
              "content": "This endpoint can be used to get transaction request for withdrawing integrator's collected fees the specified chain. If a list of token addresses is provided, the generated transaction will only withdraw the specified funds.\nIf there is no collected fees for the provided token's addresses, the `400` error will be thrown.\nThe endpoint returns a `IntegratorWithdrawalTransactionResponse` object which contains the transaction request.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "integrators",
                ":integratorId",
                "withdraw",
                ":chainId"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "tokenAddresses",
                  "value": "<string>",
                  "description": "Specify tokens from which funds should be withdraw"
