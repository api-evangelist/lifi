          "name": "Returns all possible connections between two chains.",
          "request": {
            "name": "Returns all possible connections between two chains.",
            "description": {
              "content": "This endpoint gives information about all possible transfers between chains.\n`fromChain` and `toChain` are required. Additional filters such as token, bridge, and exchange can be used to narrow the result further.\nInformation about which chains and tokens are supported can be taken from the response of the /v1/chains endpoint.\nInformation about which bridges and exchanges are supported can be taken from the response of the `/v1/tools` endpoint.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "connections"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "fromChain",
                  "value": "<string>",
                  "description": "(Required) The chain that should be the start of the possible connections."
                },
                {
                  "disabled": false,
                  "key": "toChain",
                  "value": "<string>",
                  "description": "(Required) The chain that should be the end of the possible connections."
                },
                {
                  "disabled": false,
                  "key": "fromToken",
                  "value": "<string>",
                  "description": "Only return connections starting with this token."
                },
                {
                  "disabled": false,
                  "key": "toToken",
                  "value": "<string>",
                  "description": "Only return connections ending with this token."
                },
                {
                  "disabled": false,
                  "key": "chainTypes",
                  "value": "<string>",
                  "description": "Restrict the resulting connections to the given chainTypes. Available values: EVM, SVM, UTXO, MVM, TVM."
                },
                {
                  "disabled": false,
                  "key": "allowBridges",
                  "value": "<string>",
                  "description": "List of bridges that are allowed for this transaction. Retrieve the current catalog from the `/v1/tools` endpoint."
                },
                {
                  "disabled": false,
                  "key": "allowBridges",
                  "value": "<string>",
