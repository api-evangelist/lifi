                "header": [
                  {
                    "description": "Authentication header, register in the LI.FI Partner Portal (https://portal.li.fi/ ) to get your API Key.",
                    "key": "x-lifi-api-key",
                    "value": "<string>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/v1/tokens?chains=<string>&tags=<string>&chainTypes=<string>&minPriceUSD=<number>",
