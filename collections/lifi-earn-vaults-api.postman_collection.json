                  "raw": "{{baseUrl}}/v1/vaults?chainId=<integer>&asset=<string>&protocol=<string>&minTvlUsd=<number>&isTransactional=true&isRedeemable=true&isComposerSupported=true&sortBy=tvl&cursor=<string>&limit=<integer>",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "v1",
                    "vaults"
                  ],
                  "query": [
                    {
                      "description": "Filter by EVM chain ID (e.g., `8453` for Base, `1` for Ethereum).",
                      "key": "chainId",
                      "value": "<integer>"
                    },
                    {
                      "description": "Filter by underlying token symbol or address (e.g., `USDC`).",
                      "key": "asset",
                      "value": "<string>"
                    },
                    {
                      "description": "Filter by protocol name (e.g., `morpho-v1`, `aave-v3`).",
                      "key": "protocol",
                      "value": "<string>"
                    },
                    {
                      "description": "Minimum TVL in USD. Use this to filter out low-liquidity vaults (e.g., `1000000` for $1M+).",
                      "key": "minTvlUsd",
                      "value": "<number>"
                    },
                    {
                      "description": "Filter by whether the vault supports programmatic deposits and withdrawals via the Composer API. Pass `true` to return only transactional vaults.",
                      "key": "isTransactional",
                      "value": "true"
                    },
                    {
                      "description": "Filter by whether the vault currently supports redemptions (withdrawals). Pass `true` to return only vaults that can be redeemed.",
                      "key": "isRedeemable",
                      "value": "true"
                    },
                    {
                      "description": "Filter by whether the vault is fully supported by the LI.FI Composer. Pass `true` to return only vaults ready for end-to-end cross-chain deposit flows.",
                      "key": "isComposerSupported",
                      "value": "true"
                    },
                    {
                      "description": "Sort order for results. `apy` sorts by highest total APY first. `tvl` sorts by highest TVL first.",
                      "key": "sortBy",
                      "value": "tvl"
                    },
                    {
                      "description": "Pagination cursor from a previous response's `nextCursor` field. Omit to start from the beginning.",
                      "key": "cursor",
                      "value": "<string>"
                    },
                    {
                      "description": "Number of results per page. Defaults to `50`.",
                      "key": "limit",
                      "value": "<integer>"
                    }
                  ]
                },
                "description": "Returns a paginated list of vaults with optional filtering and sorting."
