{
  "opencollection": "1.0.0",
  "info": {
    "name": "LI.FI Earn advanced Tokens API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-lifi-api-key",
      "value": "{{x-lifi-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Tokens",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Fetch all known tokens",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://earn.li.fi/v1/tokens",
            "headers": [
              {
                "name": "x-lifi-api-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "chains",
                "value": "POL,DAI",
                "type": "query",
                "description": "Restrict the resulting tokens to the given chains"
              },
              {
                "name": "tags",
                "value": "stablecoin",
                "type": "query",
                "description": "Restrict the resulting tokens to the given token tags (comma separated)"
              },
              {
                "name": "chainTypes",
                "value": "EVM,SVM,UTXO,MVM,TVM",
                "type": "query",
                "description": "Restrict the resulting tokens to the given chainTypes. Available values: EVM, SVM, UTXO, MVM, TVM."
              },
              {
                "name": "minPriceUSD",
                "value": "0.01",
                "type": "query",
                "description": "Filters results by minimum token price in USD. Minimum value for this parameter is 0. Defaults to 0.0001 USD."
              }
            ]
          },
          "docs": "This endpoint can be used to fetch all tokens known to the LI.FI services."
        }
      ]
    }
  ],
  "bundled": true
}