        {
          "id": "0855bc73-66c0-4580-87cf-851a45c2dfb7",
          "name": "Get the total amount of a token received on a specific chain, for cross-chain transfers.",
          "request": {
            "name": "Get the total amount of a token received on a specific chain, for cross-chain transfers.",
            "description": {
              "content": "Calculates and returns the total received token amount per wallet address, per sending chain, within a specified time range, for a given receiving chain and receiving token. Only aggregates cross-chain transfers, meaning transfers with distinct sending and receiving chains.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "analytics",
                "transfers",
                "summary"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "10",
                  "description": "Pagination limit. Defines the maximum number of returned results."
                },
                {
                  "disabled": false,
                  "key": "next",
                  "value": "<string>",
                  "description": "The next page cursor. Must come from the `next` field of the response of the previous request."
                },
                {
                  "disabled": false,
                  "key": "previous",
                  "value": "<string>",
                  "description": "The previous page cursor. Must come from the `previous` field of the response of the previous request."
                },
                {
                  "disabled": false,
                  "key": "fromTimestamp",
                  "value": "<string>",
                  "description": "(Required) A Unix timestamp in seconds marking the start of the query period, inclusive. Transactions older than this timestamp will not be included in the summary.\n"
                },
                {
                  "disabled": false,
                  "key": "toTimestamp",
                  "value": "<string>",
                  "description": "(Required) A Unix timestamp in seconds marking the end of the query period, inclusive. Transactions after this timestamp will not be included in the summary. **The maximum range supported by the endpoint is 30 days.**\n"
                },
                {
                  "disabled": false,
                  "key": "toChain",
                  "value": "<string>",
                  "description": "(Required) The ID, or key of the chain on the receiving side of the transfer. This parameter filters the summary to include only transfers received on the specified chain.\n"
                },
                {
                  "disabled": false,
                  "key": "toToken",
                  "value": "<number>",
                  "description": "(Required) The address, or symbol of the token received in the transfers. This parameter filters the summary to include only transfers involving the specified token on the receiving chain.\n"
                },
                {
                  "disabled": false,
                  "key": "fromChain",
                  "value": "<number>",
                  "description": "The ID, or key of the chain on the sending side of the transfers. This parameter filters the summary to include only transfers sent from the specified chain.\n"
                },
                {
                  "disabled": false,
                  "key": "integrator",
                  "value": "<string>",
                  "description": "The integrator string to filter transfers by. This parameter filters the summary to include only transfers for the given integrator.\n"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
