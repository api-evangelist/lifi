          "request": {
            "name": "Get a list of filtered transfers",
            "description": {
              "content": "This endpoint can be used to retrieve a list of transfers filtered by certain properties. Returns a maximum of 1000 transfers.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "analytics",
                "transfers"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "integrator",
