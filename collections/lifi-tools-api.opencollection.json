{
  "opencollection": "1.0.0",
  "info": {
    "name": "LI.FI Earn advanced Tools API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-lifi-api-key",
      "value": "{{x-lifi-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Tools",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get available bridges and exchanges",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://earn.li.fi/v1/tools",
            "headers": [
              {
                "name": "x-lifi-api-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "chains",
                "value": "",
                "type": "query",
                "description": "The ids of the chains that should be taken into consideration."
              }
            ]
          },
          "docs": "This endpoint can be used to get information about the bridges and exchanges available trough our service"
        }
      ]
    }
  ],
  "bundled": true
}